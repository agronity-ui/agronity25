# Supabase public client - sudah diisi dari data yang kamu kirim
NEXT_PUBLIC_SUPABASE_URL=https://lfajzhsafoscgtxwyekj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_LXQB2iubrJlAmGExeVhrfQ_POzDP5f7
SUPABASE_PROJECT_ID=lfajzhsafoscgtxwyekj

# SERVER ONLY: ambil dari Supabase Dashboard > Project Settings > API > service_role/secret key
# Jangan share ke publik dan jangan commit ke GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_TIMEZONE=Asia/Makassar

# AI backend. Isi agar AgronityAI aktif real.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional push notification / Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# OCR default: Tesseract.js browser, tidak butuh API key.
OCR_PROVIDER=tesseractjs
OCR_API_KEY=

# Cron / Edge Function secret. Pakai nilai random panjang sebelum deploy.
CRON_SECRET=change-this-long-random-secret
